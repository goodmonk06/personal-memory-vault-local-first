# Server Configuration
PORT=3001
HOST=0.0.0.0

# Database Configuration
# Options: sqlite | postgres
DB_TYPE=sqlite

# SQLite Configuration (used when DB_TYPE=sqlite)
SQLITE_DB_PATH=./data/memory-vault.db

# PostgreSQL Configuration (used when DB_TYPE=postgres)
# Uncomment and configure when you want to use Postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=memory_vault
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
